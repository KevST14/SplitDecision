# Copy to .env and adjust as needed. All values have sane defaults if unset.

# Where to store the SQLite database file.
# POLYMARKET_DB_PATH=./data/polymarket.db

# Polymarket public API bases (override only if you're pointing at a proxy/mirror).
# GAMMA_API_BASE=https://gamma-api.polymarket.com
# CLOB_API_BASE=https://clob.polymarket.com

# How often (seconds) the background poller refreshes watchlisted markets.
# POLL_INTERVAL_SECONDS=300

# Minimum price move (fraction, e.g. 0.05 = 5 percentage points) between polls
# that triggers a swing alert.
# ODDS_SWING_THRESHOLD=0.05

# Origin allowed to call this API (the frontend's dev/prod URL).
# FRONTEND_ORIGIN=http://localhost:5173
